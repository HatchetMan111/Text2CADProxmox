[Unit]
Description=text2CAD Web-Service (Text-zu-CAD fuer 3D-Druck)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/text2cad/app
Environment=PORT=8080
Environment=DATA_DIR=/opt/text2cad/data
EnvironmentFile=-/opt/text2cad/.env
ExecStart=/opt/text2cad/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
